{
  "permissions": {
    "allow": [
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler deploy *)",
      "Bash(cd worker && npx wrangler deploy)",
      "Bash(cd worker && npx wrangler deploy *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|skill",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR || '.', '.claude', 'hooks', 'check-gstack.cjs'))\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
