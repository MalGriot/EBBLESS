{
  "name": "ebbless-desktop",
  "productName": "EBBLESS",
  "version": "1.0.13",
  "description": "EBBLESS for Mac: the web app in its own window, with a mini player that floats over every app and desktop.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:local": "EBBLESS_URL=http://localhost:8934/?mal electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "ytdlp": "node fetch-ytdlp.js",
    "predist": "node fetch-ytdlp.js darwin",
    "predist:win": "node fetch-ytdlp.js win32"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.malgriot.ebbless",
    "productName": "EBBLESS",
    "files": [
      "main.js",
      "adblock.js",
      "adblock-rules.js",
      "adblock-live.js",
      "updater.js",
      "wave.js",
      "preload.js",
      "package.json",
      "ytdlp-update.js"
    ],
    "extraResources": [
      {
        "from": "../adblock",
        "to": "adblock"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "../brand/assets/icons/dock-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "bin/yt-dlp",
          "to": "bin/yt-dlp"
        }
      ]
    },
    "win": {
      "icon": "../brand/assets/icons/dock-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EBBLESS-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "bin/yt-dlp.exe",
          "to": "bin/yt-dlp.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "directories": {
      "output": "dist.noindex"
    },
    "protocols": [
      {
        "name": "EBBLESS",
        "schemes": [
          "ebbless"
        ]
      }
    ],
    "afterPack": "adhoc-sign.js"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "electron-builder@25.1.8": true
  },
  "author": "MAL GRIOT"
}
