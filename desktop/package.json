{
  "name": "ebbless-desktop",
  "productName": "EBBLESS",
  "version": "1.0.10",
  "description": "EBBLESS for Mac: the web app in its own window, with a mini player that floats over every app and desktop.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:local": "EBBLESS_URL=http://localhost:8934/?mal electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.malgriot.ebbless",
    "productName": "EBBLESS",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "../brand/assets/icons/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "icon": "../brand/assets/icons/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EBBLESS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "directories": {
      "output": "dist.noindex"
    },
    "protocols": [
      {
        "name": "EBBLESS",
        "schemes": [
          "ebbless"
        ]
      }
    ],
    "afterPack": "adhoc-sign.js"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "electron-builder@25.1.8": true
  },
  "author": "MAL GRIOT"
}
