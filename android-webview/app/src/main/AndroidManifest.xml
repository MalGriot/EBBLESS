<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Voice DJ (#553): the native speech recognizer behind the search-bar mic; audio is never recorded or stored by the app -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- the full-screen visual player (#691) is started over the lock screen by a full-screen-intent notification -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- self-updates (Updater): the sideloaded app installs its own new version -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ebbless://signin#state=..&credential=.. from desktop/signin.html -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ebbless" android:host="signin" />
            </intent-filter>
            <!-- #746: music links can open in EBBLESS (MainActivity.takeLink, checked again by MusicLinks and the page).
                 Not verified app links (we can't host assetlinks on these domains), so on Android 12+ the user turns them on
                 once in Settings > Apps > EBBLESS > Open by default > Add links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="open.spotify.com" />
                <data android:pathPrefix="/track/" />
                <data android:pathPrefix="/album/" />
                <data android:pathPrefix="/playlist/" />
                <data android:pathPrefix="/artist/" />
                <data android:pathPrefix="/show/" />
                <data android:pathPrefix="/episode/" />
                <data android:pathPattern="/intl-.*/track/.*" />
                <data android:pathPattern="/intl-.*/album/.*" />
                <data android:pathPattern="/intl-.*/playlist/.*" />
                <data android:pathPattern="/intl-.*/artist/.*" />
                <data android:pathPattern="/intl-.*/show/.*" />
                <data android:pathPattern="/intl-.*/episode/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="music.apple.com" />
                <data android:pathPattern="/.*/album/.*" />
                <data android:pathPattern="/.*/playlist/.*" />
                <data android:pathPattern="/.*/song/.*" />
                <data android:pathPattern="/.*/artist/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/channel/" />
            </intent-filter>
            <!-- #746: a link shared from the Spotify / Apple Music / YouTube / SoundCloud app's Share sheet -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- #691: full-screen player drawn over the lock screen; own task so closing it returns to the lock screen / standard player -->
        <activity
            android:name=".FullScreenPlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Bring your music: Spotify sign-in in a desktop-layout window that reads the library -->
        <activity
            android:name=".SpotifyImportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />

        <receiver android:name=".UpdateReceiver" android:exported="false" />

        <!-- #688: home screen widget (now playing controls, or Last played + Resume) -->
        <receiver
            android:name=".EbblessWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ebbless_widget_info" />
        </receiver>

        <!-- own process: survives the main (WebView) process being killed for memory, and says so -->
        <service
            android:name=".WatchdogService"
            android:process=":watchdog"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
